#!/bin/sh
uci -q set luci.main.lang='en'
uci -q delete luci.languages.zh_cn
uci -q delete luci.languages.zh_tw
uci -q set luci.themes.LettucePi='/luci-static/misectel'
uci -q commit luci
uci -q set misectel.main.brand_name='LettucePi'
uci -q set misectel.main.model_name='K45P'
uci -q set misectel.main.header_name='LettucePi K45P'
uci -q set misectel.main.apn_country='us'
uci -q commit misectel
sed -i -e 's/gateway-dashboard/dashboard/g' -e 's/gateway-wireless/wifi/g' -e 's/gateway-network/settings/g' -e 's/gateway-system/settings/g' -e 's/gateway-portmap/portmap/g' -e 's/gateway-vpnoverview/overview/g' -e 's/gateway-wireguard/wireguard/g' -e 's/gateway-openvpn/openvpn/g' -e 's/gateway-l2tp/l2tp/g' -e 's/gateway-pptp/pptp/g' -e 's/gateway-vxlan/vxlan/g' /etc/config/misectel
for r in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    uci set "wireless.$r.country=US"
done
uci commit wireless
if [ ! -s /etc/config/chester_sqm ]; then
    cp /usr/share/chester-sqm/chester_sqm.default /etc/config/chester_sqm
fi
[ -e /etc/config/chester ] || touch /etc/config/chester
uci -q set chester.update=update
uci -q get chester.update.auto >/dev/null || uci set chester.update.auto='0'
uci -q get chester.update.keep_settings >/dev/null || uci set chester.update.keep_settings='1'
uci -q commit chester
/etc/init.d/chester-sqm enable
mkdir -p /tmp/sysinfo
echo 'LettucePi K45P' > /tmp/sysinfo/model
exit 0
