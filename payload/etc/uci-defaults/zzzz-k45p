#!/bin/sh
# A clean vendor rootfs has no initial root hash. Preserve existing passwords
# on settings-preserving upgrades, and initialize a fresh router to admin.
current_hash=$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow)
case "$current_hash" in
    ''|'!'|'*'|'x') (printf 'admin\n'; sleep 1; printf 'admin\n') | passwd root >/dev/null 2>&1 || exit 1 ;;
esac
uci -q set rpcd.@login[0].username='root'
uci -q set rpcd.@login[0].password='$p$root'
uci -q set rpcd.admin='login'
uci -q set rpcd.admin.username='admin'
uci -q set rpcd.admin.password='$p$root'
uci -q delete rpcd.admin.read
uci -q delete rpcd.admin.write
uci -q add_list rpcd.admin.read='*'
uci -q add_list rpcd.admin.write='*'
uci -q commit rpcd
uci -q set luci.main.lang='en'
uci -q delete luci.languages.zh_cn
uci -q delete luci.languages.zh_tw
uci -q set luci.themes.LettucePi='/luci-static/misectel'
uci -q commit luci
uci -q set misectel.main.brand_name='LettucePi'
uci -q set misectel.main.model_name='K45P'
uci -q set misectel.main.header_name='Chester K45P'
uci -q set misectel.main.apn_country='us'
uci -q commit misectel
sed -i -e 's/gateway-dashboard/dashboard/g' -e 's/gateway-wireless/wifi/g' -e 's/gateway-network/settings/g' -e 's/gateway-system/settings/g' -e 's/gateway-portmap/portmap/g' -e 's/gateway-vpnoverview/overview/g' -e 's/gateway-wireguard/wireguard/g' -e 's/gateway-openvpn/openvpn/g' -e 's/gateway-l2tp/l2tp/g' -e 's/gateway-pptp/pptp/g' -e 's/gateway-vxlan/vxlan/g' /etc/config/misectel
for r in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    uci set "wireless.$r.country=US"
done
uci commit wireless
if [ ! -s /etc/config/chester_sqm ]; then
    cp /usr/share/chester-sqm/chester_sqm.default /etc/config/chester_sqm
fi
[ -e /etc/config/chester ] || touch /etc/config/chester
uci -q set chester.update=update
uci -q get chester.update.auto >/dev/null || uci set chester.update.auto='0'
uci -q get chester.update.keep_settings >/dev/null || uci set chester.update.keep_settings='1'
uci -q commit chester
/etc/init.d/chester-sqm enable
mkdir -p /tmp/sysinfo
echo 'Chester K45P' > /tmp/sysinfo/model
# Replace vendor defaults, while retaining a hostname the operator customized.
case "$(uci -q get system.@system[0].hostname)" in
    ''|M12K45Ultra|M02K45|K45P|OpenWrt|ImmortalWrt|LettucePi-K45P)
        uci set system.@system[0].hostname='Chester-K45P'
        uci commit system
        ;;
esac
# Migrate only the untouched vendor four-entry APN list; retain custom lists.
if [ "$(sha256sum /etc/misectel/apn-presets/us.json 2>/dev/null | cut -d' ' -f1)" = '1f417c8debf0978c37604df54cb67ea88dd73e2efc4f064e3ece2b934ac4850f' ]; then
    cp /usr/share/misectel/apn-presets/defaults/us.json /etc/misectel/apn-presets/us.json
fi
exit 0
