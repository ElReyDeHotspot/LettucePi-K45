manual=$(uci -q get qmodem.main.block_auto_probe)
[ "${manual}" = 1 ] && exit

# A Wi-Fi netdev is not a modem. Avoid queuing its PCIe radio for AT discovery.
[ -d "/sys/class/net/${INTERFACE}/phy80211" ] && exit 0
case "${INTERFACE}" in phy*-ap*|wlan*) exit 0;; esac

logger -t modem_hotplug "net slot: ${DEVPATH} action: ${ACTION}"
hotplug_add_delay=$(uci -q get qmodem.main.hotplug_add_delay || echo 8)
[ -z "${INTERFACE}" ] && exit
[ -z "${DEVPATH}" ] && exit

slot_path=$(readlink -f "/sys/${DEVPATH}/device")
[ -z "${slot_path}" ] && exit

slot=$(basename "$(dirname "${slot_path}")")

if [ -d "/sys/bus/usb/devices/${slot}" ]; then
    slot_type="usb"
elif [ -d "/sys/bus/pci/devices/${slot}" ]; then
    slot_type="pcie"
else
    exit
fi

logger -t modem_hotplug "net slot: ${slot} action: ${ACTION} slot_type: ${slot_type}"
case "${ACTION}" in
    add|\
    bind)
        (/usr/share/qmodem/modem_scan.sh add "${slot}" "${slot_type}" "${hotplug_add_delay}" >/dev/null 2>&1) &
        ;;
esac
