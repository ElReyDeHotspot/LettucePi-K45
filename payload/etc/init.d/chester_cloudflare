#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
 local dns warp
 dns=$(jsonfilter -i /etc/chester-cloudflare/settings.json -e '@.dns' 2>/dev/null)
 warp=$(jsonfilter -i /etc/chester-cloudflare/settings.json -e '@.warp' 2>/dev/null)
 if [ "$warp" != true ]; then
  case "$dns" in cloudflare|malware|family) ;; *) return 0;; esac
 fi
 procd_open_instance
 procd_set_param command /usr/libexec/chester-cloudflare daemon
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_stopped() {
 /usr/libexec/chester-cloudflare cleanup
}
