#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
start_service() {
 procd_open_instance
 procd_set_param command /usr/bin/misectel-fan-monitor 5 2
 procd_set_param file /etc/config/misectel
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 3
 procd_close_instance
}
reload_service() {
 procd_send_signal misectel-fan-control '*' USR1
}
service_triggers() {
 procd_add_reload_trigger misectel
}
