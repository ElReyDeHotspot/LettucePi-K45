#!/bin/sh /etc/rc.common
START=99
STOP=9
USE_PROCD=1
start_service() {
    # All QModem readers must share the AT daemon transport.
    for section in $(uci -q show qmodem | sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p'); do
        [ "$(uci -q get qmodem.$section.use_ubus)" = 1 ] && continue
        uci set qmodem.$section.use_ubus=1
    done
    uci -q changes qmodem | grep -q . && uci commit qmodem
    procd_open_instance
    procd_set_param command /usr/sbin/chester-simd daemon
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 180
    procd_close_instance
}
