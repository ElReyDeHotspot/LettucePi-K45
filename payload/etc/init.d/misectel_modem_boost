#!/bin/sh /etc/rc.common

if [ "$1" = "__run_loop" ]; then
	shift
	. /lib/functions.sh
	__MISECTEL_BOOST_DIRECT_RUN=1
fi

START=90
STOP=10
USE_PROCD=1

LOGGER_TAG="misectel_modem_boost"
BOOST_BANDS="5 8 28"
CHECK_INTERVAL=5

. /lib/functions.sh

gpio_base()
{
	local gpio="$1"

	case "$gpio" in
		''|*[!A-Za-z0-9_.:-]*)
			return 1
			;;
	esac

	printf '/sys/class/gpio/%s' "$gpio"
}

read_boost_gpio()
{
	config_load misectel
	config_get boost_cap main boost_cap 0
	config_get boost_gpio main boost_gpio

	[ "$boost_cap" = "1" ] && [ -n "$boost_gpio" ] || return 1
	gpio_base "$boost_gpio"
}

read_boost_mode()
{
	config_load misectel
	config_get boost_mode main boost_mode auto

	case "$boost_mode" in
		manual|manual_on|manual_off)
			boost_mode="manual"
			;;
		*)
			boost_mode="auto"
			;;
	esac

	printf '%s' "$boost_mode"
}

read_boost_manual_value()
{
	config_load misectel
	config_get boost_manual_value main boost_manual_value 0

	[ "$boost_manual_value" = "1" ] || boost_manual_value="0"
	printf '%s' "$boost_manual_value"
}

set_boost_value()
{
	local base="$1"
	local value="$2"

	[ -e "$base/value" ] || return 1
	[ -e "$base/direction" ] && echo out > "$base/direction" 2>/dev/null
	echo "$value" > "$base/value" 2>/dev/null
}

is_boost_band()
{
	local rat="$1"
	local cell_band="$2"
	local band_name="$3"
	local band

	rat="$(printf '%s' "$rat" | tr '[:lower:]' '[:upper:]')"
	case "$rat" in
		NR|LTE) ;;
		*) return 1 ;;
	esac

	cell_band="$(printf '%s' "$cell_band" | tr '[:lower:]' '[:upper:]')"
	band_name="$(printf '%s' "$band_name" | tr '[:lower:]' '[:upper:]')"

	for band in $BOOST_BANDS; do
		case "$rat" in
			NR)
				if [ "$cell_band" = "$band" ] || [ "$cell_band" = "N$band" ]; then
					return 0
				fi
				printf '%s' "$band_name" | grep -Eiq '(^|[^A-Z0-9])NR[[:space:]]+N?'"$band"'([^A-Z0-9]|$)' && return 0
				printf '%s' "$band_name" | grep -Eiq '(^|[^A-Z0-9])N'"$band"'([^A-Z0-9]|$)' && return 0
				;;
			LTE)
				if [ "$cell_band" = "$band" ] || [ "$cell_band" = "B$band" ]; then
					return 0
				fi
				printf '%s' "$band_name" | grep -Eiq '(^|[^A-Z0-9])(LTE[[:space:]]+)?B'"$band"'([^A-Z0-9]|$)' && return 0
				;;
		esac
	done

	return 1
}

current_band_has_boost_band()
{
	local cfg="$1"
	local current_band status idx rat cell_band band_name

	current_band="$(ubus call qmodem get_current_band '{"config_section":"'"$cfg"'"}' 2>/dev/null)"
	[ -n "$current_band" ] || return 1

	status="$(jsonfilter -s "$current_band" -e '@.current_band.status' 2>/dev/null)"
	[ "$status" = "ok" ] || return 1

	idx=0
	while [ "$idx" -lt 16 ]; do
		rat="$(jsonfilter -s "$current_band" -e '@.current_band.cells['"$idx"'].rat' 2>/dev/null)"
		cell_band="$(jsonfilter -s "$current_band" -e '@.current_band.cells['"$idx"'].band' 2>/dev/null)"
		band_name="$(jsonfilter -s "$current_band" -e '@.current_band.cells['"$idx"'].band_name' 2>/dev/null)"

		[ -n "$rat$cell_band$band_name" ] || break
		is_boost_band "$rat" "$cell_band" "$band_name" && return 0

		idx=$((idx + 1))
	done

	return 1
}

check_modem_section()
{
	local cfg="$1"
	local state disabled

	[ "$boost_target" = "1" ] && return 0

	config_get state "$cfg" state
	config_get disabled "$cfg" disabled 0

	[ "$state" = "disabled" ] && return 0
	[ "$state" != "enabled" ] && return 0
	[ "$disabled" = "1" ] && return 0

	current_band_has_boost_band "$cfg" && boost_target=1
}

run_boost_loop()
{
	local base mode manual_value

	while true; do
		base="$(read_boost_gpio)" || {
			logger -t "$LOGGER_TAG" "boost disabled or gpio not configured"
			sleep "$CHECK_INTERVAL"
			continue
		}

		mode="$(read_boost_mode)"

		if [ "$mode" = "manual" ]; then
			manual_value="$(read_boost_manual_value)"

			if set_boost_value "$base" "$manual_value"; then
				logger -t "$LOGGER_TAG" "boost gpio $(basename "$base") manual value:$manual_value"
			else
				logger -t "$LOGGER_TAG" "failed to set boost gpio:$base manual value:$manual_value"
			fi

			sleep "$CHECK_INTERVAL"
			continue
		fi

		boost_target=0
		config_load qmodem
		config_foreach check_modem_section modem-device

		if set_boost_value "$base" "$boost_target"; then
			logger -t "$LOGGER_TAG" "boost gpio $(basename "$base") value:$boost_target"
		else
			logger -t "$LOGGER_TAG" "failed to set boost gpio:$base value:$boost_target"
		fi

		sleep "$CHECK_INTERVAL"
	done
}

start_service()
{
	# Unsupported/disabled hardware has no work to perform. Reload starts it if enabled.
	read_boost_gpio >/dev/null || return 0
	procd_open_instance
	procd_set_param command /bin/sh /etc/init.d/misectel_modem_boost __run_loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger 'misectel'
}

run()
{
	run_boost_loop
}

if [ "$__MISECTEL_BOOST_DIRECT_RUN" = "1" ]; then
	run_boost_loop
	exit $?
fi
