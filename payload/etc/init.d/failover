#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/failoverd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	/usr/libexec/chester-load-balance clear
	# never leave a forced cellular route behind
	ip -4 rule del priority 22222 lookup 222 2>/dev/null
	ip -4 route flush table 222 proto 222 2>/dev/null
	echo '{"running":false}' > /tmp/failover.json
}

service_triggers() {
	procd_add_reload_trigger failover
}
