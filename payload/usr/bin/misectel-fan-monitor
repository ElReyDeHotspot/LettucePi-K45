#!/bin/sh
# One owner for fan output. CPU thermal-zone enablement and trip temperatures stay intact.
. /usr/lib/chester/fan-control.sh
RUNDIR=/tmp/chester-fan
LOCK=/var/run/chester-fan.lock
mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
if ! mkdir "$LOCK" 2>/dev/null; then
 old_pid="$(cat "$LOCK/pid" 2>/dev/null)"
 case "$old_pid" in ''|*[!0-9]*) ;; *) kill -0 "$old_pid" 2>/dev/null && exit 1 ;; esac
 rm -f "$LOCK/pid"
 rmdir "$LOCK" 2>/dev/null || exit 1
 mkdir "$LOCK" || exit 1
fi
printf '%s\n' "$$" > "$LOCK/pid"
SLEEP_PID=
TARGET=
cleanup() {
 [ -z "$SLEEP_PID" ] || kill "$SLEEP_PID" 2>/dev/null
 # Return the fan to its kernel owner if this controller stops or is restarted.
 [ -z "$TARGET" ] || chester_fan_output "$TARGET" 255
 chester_fan_restore_policies "$RUNDIR/policies"
 printf '{"ready":false}\n' > "$RUNDIR/status.json"
 rm -f "$LOCK/pid"
 rmdir "$LOCK" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 0' INT TERM
trap 'RELOAD=1; [ -z "$SLEEP_PID" ] || kill "$SLEEP_PID" 2>/dev/null' USR1 HUP
# Recover the recorded policy after an unclean controller exit before acquiring it again.
chester_fan_restore_policies "$RUNDIR/policies"
fan_count=0
for node in /sys/class/hwmon/hwmon*; do
 case "$(cat "$node/name" 2>/dev/null)" in pwmfan|pwm-fan) fan_count=$((fan_count+1)); TARGET="$node/pwm1_enable" ;; esac
 done
[ "$fan_count" = 1 ] || { logger -t chester-fan 'Expected one controllable fan'; exit 1; }
CPU_TEMP=
for zone in /sys/class/thermal/thermal_zone*; do
 case "$(cat "$zone/type" 2>/dev/null)" in cpu-thermal|cpu_thermal)
  chester_fan_claim_policy "$zone" "$RUNDIR/policies" || { logger -t chester-fan 'Cannot safely acquire fan-only thermal zone'; exit 1; }
  CPU_TEMP="$zone/temp"
 ;; esac
 done
[ -n "$CPU_TEMP" ] || { logger -t chester-fan 'CPU temperature zone unavailable'; exit 1; }
RELOAD=1
AUTO_STATE=0
BOOST=0
while :; do
 if [ "$RELOAD" = 1 ]; then
  MODE="$(uci -q get misectel.main.fan_mode)"
  case "$MODE" in 0|1|2) ;; *) MODE=1 ;; esac
  PERCENT="$(uci -q get misectel.main.fan_speed_percent)"
  DUTY="$(chester_fan_percent_duty "$PERCENT")" || DUTY=255
  THRESHOLD="$(uci -q get misectel.main.fan_temp_threshold)"
  case "$THRESHOLD" in ''|*[!0-9]*) THRESHOLD=55 ;; esac
  [ "$THRESHOLD" -ge 1 ] && [ "$THRESHOLD" -le 150 ] || THRESHOLD=55
  AUTO_STATE=0
  RELOAD=0
 fi
 raw="$(cat "$CPU_TEMP" 2>/dev/null)"
 case "$raw" in ''|*[!0-9]*) TEMP=0; output=255; BOOST=1 ;; *)
  TEMP=$((raw / 1000))
  BOOST="$(chester_fan_boost_state "$TEMP" "$BOOST")"
  if [ "$BOOST" = 1 ]; then output=255
  else
   case "$MODE" in
    0) output=0 ;;
    1) output="$DUTY" ;;
    2)
     AUTO_STATE="$(chester_fan_auto_state "$TEMP" "$THRESHOLD" "$AUTO_STATE")"
     if [ "$AUTO_STATE" = 1 ]; then output="$DUTY"; else output=0; fi
    ;;
   esac
  fi
 ;; esac
 ready=false
 chester_fan_output "$TARGET" "$output" && ready=true
 printf '{"ready":%s,"mode":"%s","requested_pwm":%s,"setting_pwm":%s,"threshold":%s,"temperature":%s,"boost":%s,"updated":%s}\n' "$ready" "$MODE" "$output" "$DUTY" "$THRESHOLD" "$TEMP" "$BOOST" "$(date +%s)" > "$RUNDIR/status.tmp"
 mv "$RUNDIR/status.tmp" "$RUNDIR/status.json"
 sleep 5 & SLEEP_PID=$!
 wait "$SLEEP_PID" 2>/dev/null
 SLEEP_PID=
 done
