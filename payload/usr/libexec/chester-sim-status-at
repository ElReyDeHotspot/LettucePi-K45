#!/bin/sh
# Read-only SIM status. Share QModem's port lock without waiting behind a scan.
case "$1" in /dev/mhi_DUN|/dev/ttyUSB[0-9]*|/dev/ttyACM[0-9]*) ;; *) exit 2;; esac
case "$2" in core|'AT+QUIMSLOT?'|'AT+QSIMSTAT?'|'AT+CPIN?'|'AT+QSIMDET?'|'AT+QCCID'|'AT+COPS?'|'AT+QENG="servingcell"') ;; *) exit 2;; esac
[ -c "$1" ] || exit 1
key=$(printf '%s' "$1" | tr -c 'A-Za-z0-9_' '_')
exec 6>"/var/lock/qmodem-at-$key.lock"
flock -w 2 -x 6 || exit 1
if [ "$2" = core ]; then
 tom_modem -u -d "$1" -o a -t 2 -c 'AT+QUIMSLOT?'
 tom_modem -u -d "$1" -o a -t 2 -c 'AT+QSIMSTAT?'
 exec tom_modem -u -d "$1" -o a -t 2 -c 'AT+CPIN?'
fi
exec tom_modem -u -d "$1" -o a -t 2 -c "$2"
