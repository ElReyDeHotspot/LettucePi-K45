#!/bin/sh
# Read-only procfs metrics. Successive samples avoid sleeping in rpcd.
umask 077
state_dir=/tmp/chester-runtime-metrics
mkdir -p -m 700 "$state_dir" || exit 1
exec 8>"$state_dir/lock"
if ! flock -n -x 8; then
 cat "$state_dir/result" 2>/dev/null || printf '{}\n'
 exit 0
fi
awk -v state="$state_dir/sample" '
 BEGIN {
  if ((getline line < state)>0) split(line,previous," ")
  close(state)
  available=-1
 }
 FILENAME=="/proc/uptime" { now=$1*1000 }
 FILENAME=="/proc/stat" && $1=="cpu" {
  for(i=2;i<=9;i++)ticks+=$i
  idle=$5+$6
 }
 FILENAME=="/proc/meminfo" && $1=="MemTotal:" { memory=$2*1024 }
 FILENAME=="/proc/meminfo" && $1=="MemAvailable:" { available=$2*1024 }
 END {
  if(ticks<=0 || memory<=0 || available<0) {print "{}";exit}
  elapsed=now-previous[3];delta=ticks-previous[1];idle_delta=idle-previous[2]
  cpu="null";sample_ms=0
  if(previous[1]>0 && elapsed>=250 && elapsed<=30000 && delta>0 && idle_delta>=0 && idle_delta<=delta) {
   cpu=sprintf("%.1f",100*(delta-idle_delta)/delta);sample_ms=elapsed
  } else if(previous[1]>0 && elapsed>=0 && elapsed<250) {
   cpu=previous[4];sample_ms=previous[5]
  }
  if(previous[1]==0 || elapsed<0 || elapsed>=250) {
   printf "%.0f %.0f %.0f %s %.0f\n",ticks,idle,now,cpu,sample_ms > state
   close(state)
  }
  printf "{\"cpu_percent\":%s,\"sample_ms\":%.0f,\"memory\":{\"total\":%.0f,\"available\":%.0f},\"source\":\"procfs\"}\n",cpu,sample_ms,memory,available
 }' /proc/uptime /proc/stat /proc/meminfo > "$state_dir/result.new"
if [ -s "$state_dir/result.new" ]; then
 mv "$state_dir/result.new" "$state_dir/result"
 cat "$state_dir/result"
else
 printf '{}\n'
fi
