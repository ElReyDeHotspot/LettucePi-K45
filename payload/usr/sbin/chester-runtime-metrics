#!/bin/sh
# Measure aggregate CPU utilization over one second; exclude guest double-counting.
read_cpu() { awk '$1=="cpu" { total=0; for(i=2;i<=9;i++)total+=$i; print total,$5+$6; exit }' /proc/stat; }
set -- $(read_cpu)
total_before=$1
idle_before=$2
sleep 1
set -- $(read_cpu)
total_delta=$(($1-total_before))
idle_delta=$(($2-idle_before))
awk -v total_delta="$total_delta" -v idle_delta="$idle_delta" '
 BEGIN { available=-1 }
 /^MemTotal:/ { total=$2*1024 }
 /^MemAvailable:/ { available=$2*1024 }
 END {
  if(total_delta<=0 || total<=0 || available<0) { print "{}"; exit }
  cpu=100*(total_delta-idle_delta)/total_delta
  if(cpu<0)cpu=0; if(cpu>100)cpu=100
  printf "{\"cpu_percent\":%.1f,\"sample_ms\":1000,\"memory\":{\"total\":%.0f,\"available\":%.0f},\"source\":\"procfs\"}\n",cpu,total,available
 }' /proc/meminfo
