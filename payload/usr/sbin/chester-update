#!/bin/sh
# K45P FIT updater. Never substitutes the K43P flash method or forces checks.
set -eu
# Routine updates use the independently signed app channel after bootstrap.
# The full-image path remains explicit for changes to the firmware base.
case "${1:-status}" in
 status|status-local)
  if [ -x /usr/libexec/chester-app-update ]; then exec /usr/libexec/chester-app-update "${1:-status}"; fi;;
 install)
  if [ -x /usr/libexec/chester-app-update ]; then
   app_id=${2:-$(tr -d '-' < /proc/sys/kernel/random/uuid)}
   exec /usr/libexec/chester-app-update install "$app_id"
  fi;;
 firmware-status) shift; set -- status "$@";;
 firmware-install) shift; set -- install "$@";;
esac
umask 077
MANIFEST_URL=https://raw.githubusercontent.com/ElReyDeHotspot/LettucePi-K45/main/firmware/latest.json
RAW_BASE=https://raw.githubusercontent.com/ElReyDeHotspot/LettucePi-K45
REF_URL=https://api.github.com/repos/ElReyDeHotspot/LettucePi-K45/git/ref/heads/main
VERSION_FILE=/etc/chester-version
LOG=/tmp/chester-update.log
JOB=/tmp/chester-update-job.json
RUN_ID=
job() {
    jq -n --arg id "$RUN_ID" --arg phase "$1" --arg message "$2" --argjson updated "$(date +%s)" \
        '{id:$id,phase:$phase,message:$message,updated:$updated,recovering:false}' > "$JOB.tmp"
    mv -f "$JOB.tmp" "$JOB"
}
fail() { job failed "$1"; echo "FAIL: $1"; exit 1; }
field() { sed -n "s/^$1=//p" "$VERSION_FILE" 2>/dev/null | head -1; }
local_status() {
    os_version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release 2>/dev/null | tr -d '\"')
    jq -n --arg iv "$(field version)" --arg ib "$(field build)" --arg id "$(field built)" --arg iN "$(field bin)" \
      --arg board "$(cat /tmp/sysinfo/board_name 2>/dev/null || true)" --arg model "$(cat /tmp/sysinfo/model 2>/dev/null || true)" \
      --arg kernel "$(uname -r)" --arg os "$os_version" \
      '{ok:true,local_only:true,installed_version:$iv,installed_build:$ib,installed_built:$id,installed_bin:$iN,board:$board,model:$model,kernel:$kernel,os_version:$os}'
}
fetch_manifest() {
    # Resolve once, then keep manifest and image on that immutable commit.
    head_json=$(curl -fsSL --connect-timeout 10 --max-time 30 "$REF_URL?cb=$(date +%s)") || return 1
    MANIFEST_REF=$(printf '%s' "$head_json" | jq -er '.object.sha') || return 1
    [ "${#MANIFEST_REF}" = 40 ] || return 1
    case "$MANIFEST_REF" in *[!0-9a-f]*) return 1 ;; esac
    curl -fsSL --connect-timeout 10 --max-time 30 "$RAW_BASE/$MANIFEST_REF/firmware/latest.json" > "$1" || return 1
    curl -fsSL --connect-timeout 10 --max-time 30 "$RAW_BASE/$MANIFEST_REF/firmware/latest.json.sig" > "$1.sig" || return 1
    /usr/libexec/chester-verify-manifest "$1" "$1.sig" >/dev/null || return 1
}
case "${1:-status}" in
job-status)
    if [ -s "$JOB" ]; then cat "$JOB"; else printf '{"phase":"idle"}\n'; fi
    ;;
status-local)
    local_status
    ;;
status)
    t=$(mktemp /tmp/k45p-manifest.XXXXXX); trap 'rm -f "$t" "$t.sig"' EXIT
    if ! fetch_manifest "$t"; then
        local_status | jq '. + {ok:false,local_only:false,error:"Could not reach or verify the signed K45P release. Please try again."}'
        exit 0
    fi
    local_status | jq --slurpfile release "$t" '
      . as $installed | . + ($release[0] |
      {ok:true,local_only:false,release_verified:true,installed_version:$installed.installed_version,
       latest_version:.version,latest_build:.build,latest_built:.built,latest_sha:.sha256,size:.size,
       latest_bin:.bin,release_board:.board,notes:.notes,update_available:(.build > $installed.installed_build)})'
    ;;
install)
    [ "$(cat /tmp/sysinfo/board_name)" = 'misectel,m02k45' ] || { echo 'FAIL: unsupported board'; exit 1; }
    RUN_ID=${2:-}
    case "$RUN_ID" in *[!0-9a-f]*) exit 2;; esac
    [ -z "$RUN_ID" ] || [ "${#RUN_ID}" = 32 ] || exit 2
    mkdir -p /var/lock
    exec 9>/var/lock/chester-update.lock
    flock -xn 9 || { echo 'FAIL: an update is already running'; exit 1; }
    : > "$LOG"
    job queued 'The update is queued.'
    setsid "$0" run-install "$RUN_ID" </dev/null >>"$LOG" 2>&1 &
    echo 'OK: Update started.'
    ;;
run-install)
    flock -xn 9 || exit 1
    RUN_ID=${2:-}
    t=$(mktemp /tmp/k45p-manifest.XXXXXX)
    trap 'rm -f "$t" "$t.sig"' EXIT
    job checking 'Checking the signed release and router compatibility.'
    fetch_manifest "$t" || fail 'The signed K45P release could not be verified.'
    [ "$(jq -r .build "$t")" -gt "$(field build)" ] || fail 'The release is already installed or older.'
    url=$(jq -r .url "$t"); sha=$(jq -r .sha256 "$t"); size=$(jq -r .size "$t")
    url="$RAW_BASE/$MANIFEST_REF/${url#"$RAW_BASE/main/"}"
    job preparing 'Preparing temporary storage for the update.'
    [ "$(df -k /tmp | awk 'NR==2 {print $4}')" -gt $((size / 1024 + 16384)) ] || fail 'There is not enough temporary memory for this update.'
    img=/tmp/k45p-sysupgrade.itb
    job downloading 'Downloading the signed firmware. Keep the router powered on.'
    curl --http1.1 -fL --retry 3 --connect-timeout 20 --max-time 1200 -o "$img.part" "$url" >> "$LOG" 2>&1 || fail 'The firmware download failed.'
    job verifying 'Checking the firmware size, checksum and compatibility.'
    [ "$(wc -c < "$img.part" | tr -d ' ')" = "$size" ] || fail 'The downloaded firmware size is incorrect.'
    [ "$(sha256sum "$img.part" | awk '{print $1}')" = "$sha" ] || { rm -f "$img.part"; fail 'The downloaded firmware checksum is incorrect.'; }
    mv "$img.part" "$img"
    sysupgrade -T "$img" >> "$LOG" 2>&1 || fail 'Stock K45P image validation failed.'
    uci set chester.update.minimum_build="$(jq -r .build "$t")"
    uci commit chester
    job installing 'Installing the verified firmware and restarting the router.'
    sleep 3
    if [ "$(uci -q get chester.update.keep_settings || true)" = 0 ]; then
        sysupgrade -n "$img" >> "$LOG" 2>&1 || fail 'Sysupgrade did not accept the verified firmware.'
    else
        sysupgrade "$img" >> "$LOG" 2>&1 || fail 'Sysupgrade did not accept the verified firmware.'
    fi
    ;;
auto-run)
    [ "$(uci -q get chester.update.auto || true)" = 1 ] || exit 0
    "$0" status | jq -e '.ok and .update_available' >/dev/null || exit 0
    "$0" install
    ;;
*) echo 'usage: chester-update status-local|status|install|auto-run' >&2; exit 2 ;;
esac
