#!/usr/bin/ucode
'use strict';
import {popen} from 'fs';
function request(action,settings){let body={action:action};if(settings!=null)body.config=settings;let argument="'"+replace(sprintf('%J',body),/'/g,"'\\''")+"'";let f=popen('/usr/libexec/chester-traffic guard '+argument,'r');if(!f)return {success:false,error:'Protection service is unavailable.'};let s=f.read('all');f.close();try{return json(s);}catch(e){return {success:false,error:'Could not read the protection response.'};}}
return {'chester.guard':{
 status:{call:()=>request('status')},
 save:{args:{settings:'String'},call:r=>{if(length(r.args.settings)>196608)return {success:false,error:'Protection settings are too large.'};let c;try{c=json(r.args.settings);}catch(e){return {success:false,error:'Invalid protection settings.'};}if(type(c)!='object')return {success:false,error:'Invalid protection settings.'};return request('save',c);}},
 update:{call:()=>request('update')}
}};
