#!/usr/bin/ucode
'use strict';
import {popen} from 'fs';
function quote(s){return "'"+replace(s,"'","'\\''")+"'";}
function call(action,arg){
 let f=popen('/usr/libexec/chester-cloudflare '+action+(arg?' '+quote(arg):''),'r');
 if(!f)return {success:false,error:'Cloudflare service is unavailable'};
 let text=f.read('all');f.close();try{return json(text);}catch(e){return {success:false,error:'Cloudflare operation could not be verified'};}
}
return {'chester.cloudflare':{
 status:{call:()=>call('status')},
 save:{args:{settings:'String'},call:(r)=>length(r.args.settings||'')<=8192?call('save',r.args.settings):{success:false,error:'Settings are too long'}},
 register:{args:{accepted:'String'},call:(r)=>r.args.accepted=='1'?call('register','accepted'):{success:false,error:'Accept Cloudflare application terms before registration'}},
 test_dns:{call:()=>call('test_dns')},
 test_warp:{call:()=>call('test_warp')}
}};
