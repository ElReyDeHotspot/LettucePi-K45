#!/usr/bin/ucode
'use strict';
import { open, popen } from 'fs';
import { cursor } from 'uci';

function config(ctx) {
    return {
        enabled: ctx.get('failover','main','enabled') == '1',
        mode: ctx.get('failover','main','mode') || 'auto',
        primary: ctx.get('failover','main','primary') || 'wan',
        backup: ctx.get('failover','main','backup') || 'pcie0',
        targets: ctx.get('failover','main','target') || ['1.1.1.1','8.8.8.8'],
        interval: ctx.get('failover','main','interval') || '2',
        fail_count: ctx.get('failover','main','fail_count') || '1',
        recover_count: ctx.get('failover','main','recover_count') || '3',
        timeout: ctx.get('failover','main','timeout') || '1'
    };
}
function validNumber(s, lo, hi) {
    return match(s || '', /^[0-9]+$/) && +s >= lo && +s <= hi;
}
function invalid(message) { return {success:false, error:message}; }
function readText(path) {
    let f=open(path,'r'); if (!f) return '';
    let s=f.read('all') || ''; f.close(); return s;
}
function exists(path) { let f=open(path,'r'); if (!f) return false; f.close(); return true; }
function testStatus() {
    let base='/tmp/chester-link-test/', lock='/tmp/chester-link-test.lock/';
    let pid=trim(readText(lock+'pid')), role=trim(readText(lock+'role'));
    let running=!!match(pid,/^[0-9]+$/) && !!length(readText('/proc/'+pid+'/status'));
    let out={running:running,role:running?role:'',results:[]};
    for (let r in ['primary','secondary']) {
        let path=base+r+'/', text=readText(path+'meta.json'), meta;
        if (!length(text)) continue;
        try { meta=json(text); } catch(e) { continue; }
        let result={role:r,iface:meta.iface,device:meta.device,timestamp:meta.timestamp,phase:'starting'};
        let summary=null;
        for (let line in split(readText(path+'output.jsonl'),'\n')) {
            let ev; try { ev=json(line); } catch(e) { continue; }
            if (ev.Key=='starting' || ev.Key=='connected') result.phase=ev.Value.Test;
            if (ev.ServerFQDN) summary=ev;
        }
        if (summary) {
            result.server=summary.ServerFQDN;
            if (summary.Download) {
                result.download_mbps=summary.Download.Throughput.Value;
                result.latency_ms=summary.Download.Latency.Value;
            }
            if (summary.Upload) result.upload_mbps=summary.Upload.Throughput.Value;
        }
        if (exists(path+'cancelled')) result.phase='cancelled';
        else if (exists(path+'done') && summary && summary.Download && summary.Upload) result.phase='completed';
        else if (exists(path+'failed') || (!running || role!=r)) {
            result.phase='failed';
            result.error='NDT7 could not complete on this link. Check its internet access and try again.';
        }
        push(out.results,result);
    }
    return out;
}
function usesWanSocket(ctx, name) {
    if (name == 'wan') return true;
    let dev = ctx.get('network', name, 'device');
    if (type(dev) == 'array') {
        for (let d in dev) if (d == 'wan' || d == '@wan') return true;
        return false;
    }
    return dev == 'wan' || dev == '@wan';
}
function needsWanSocket(ctx, a) {
    return (a.mode != 'cell' && usesWanSocket(ctx, a.primary)) ||
           (a.mode != 'wan' && usesWanSocket(ctx, a.backup));
}

return { failover: {
    status: { call: function() {
        let ctx=cursor(), out={running:false};
        let f=open('/tmp/failover.json','r');
        if (f) { try {out=json(f.read('all'));} catch(e) {} f.close(); }
        out.config=config(ctx);
        out.wan_is_lan=ctx.get('misectel','network_defaults','optional_wan_mode') == 'lan';
        out.vendor_failover=ctx.get('misectel','wan5g_switch','enabled') == '1';
        out.link_tests=testStatus();
        return out;
    }},
    test_start: {
        args:{role:'String',notice:'String'},
        call:function(request) {
            let a=request.args;
            if (a.role!='primary' && a.role!='secondary') return invalid('Choose Primary or Secondary.');
            if (a.notice!='1') return invalid('Review the M-Lab privacy notice before starting.');
            let f=popen('/usr/libexec/chester-link-test start '+a.role,'r');
            if (!f) return invalid('The link-test service is unavailable.');
            let text=f.read('all');f.close();
            try { return json(text); } catch(e) { return invalid('The link-test service returned an invalid response.'); }
        }
    },
    test_cancel: {call:function() {
        let f=popen('/usr/libexec/chester-link-test cancel','r');
        if (!f) return invalid('The link-test service is unavailable.');
        let text=f.read('all');f.close();
        try {return json(text);} catch(e) {return invalid('Could not cancel the test.');}
    }},
    set_config: {
        args:{enabled:'String',mode:'String',primary:'String',backup:'String',targets:'String',interval:'String',fail_count:'String',recover_count:'String',timeout:'String'},
        call:function(request) {
            let a=request.args, ctx=cursor();
            if (a.enabled != '0' && a.enabled != '1') return invalid('Invalid enabled value.');
            if (a.mode != 'auto' && a.mode != 'balance' && a.mode != 'wan' && a.mode != 'cell') return invalid('Choose Automatic, Load Balance, Primary only, or Secondary only.');
            if (!match(a.primary || '', /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,31}$/) || !match(a.backup || '', /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,31}$/)) return invalid('Choose valid uplink interfaces.');
            if (a.primary == a.backup) return invalid('Primary and backup must be different interfaces.');
            if (!validNumber(a.interval,2,300) || !validNumber(a.fail_count,1,60) || !validNumber(a.recover_count,1,120)) return invalid('Check interval must be 2–300 seconds; failure count 1–60; recovery count 1–120.');
            let probeTimeout=a.timeout || ctx.get('failover','main','timeout') || '1';
            if (!validNumber(probeTimeout,1,5)) return invalid('Probe timeout must be 1–5 seconds.');
            let targets=[];
            for (let ip in split(a.targets || '', /[[:space:],]+/)) {
                if (!length(ip)) continue;
                if (!match(ip,/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)) return invalid('Ping targets must be IPv4 addresses.');
                for (let part in split(ip,'.')) if (!validNumber(part,0,255)) return invalid('A ping target has an invalid IPv4 octet.');
                push(targets,ip);
            }
            if (!length(targets) || length(targets)>6) return invalid('Enter between one and six ping targets.');
            if (a.enabled == '1') {
                if (ctx.get('misectel','wan5g_switch','enabled') == '1') return invalid('Turn off the existing WAN/cellular switch before enabling Failover.');
                if (needsWanSocket(ctx,a) && ctx.get('misectel','network_defaults','optional_wan_mode') == 'lan') return invalid('Change the Ethernet socket from LAN to WAN before using it as an uplink.');
            }
            for (let key in ['enabled','mode','primary','backup','interval','fail_count','recover_count']) ctx.set('failover','main',key,a[key]);
            ctx.set('failover','main','timeout',probeTimeout);
            ctx.set('failover','main','target',targets);
            if (ctx.commit('failover') !== true) return invalid('Could not save Failover settings.');
            let f=popen('touch /tmp/failover.kick; /etc/init.d/failover enabled || /etc/init.d/failover enable; /etc/init.d/failover running || /etc/init.d/failover start','r');
            if (f) f.close();
            return {success:true};
        }
    }
}};
